# Build output
target/

# Never commit event logs or anything that may contain real data
*.evtx
*.EVTX
*.evt
*.etl

# Release artifacts and signing material
*.dmg
*.p12
*.cer
*.pem
*.key
.env
.env.*

# Local / editor files
.DS_Store
.claude/
.vscode/
.idea/
*.ips

# Private local notes (contain personal details)
*.local.md

# Local icon generator (the generated icons in assets/ are committed)
scripts/make-icon.sh
scripts/make-icon.swift
